# Copy to .env.production on the VPS. Never commit the real file.
POSTGRES_PASSWORD=change-me-long-random
# "production" turns OFF phone OTP and recharge until an SMS/payment provider is wired (see auth.ts, recharge.ts).
# Use "staging" while testing with real users so OTP codes still come back as devCode.
NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-64-random-chars
ZEGO_APP_ID=123456789
ZEGO_SERVER_SECRET=0123456789abcdef0123456789abcdef
SEAT_GRACE_MS=30000
SIGNUP_BONUS_COINS=0
GOOGLE_CLIENT_ID=
