PORT=3000
DATABASE_URL=postgres://voya:voya@localhost:5433/voya
JWT_SECRET=change-me-to-a-long-random-string
# From the ZEGOCLOUD console. ServerSecret is 32 chars and must never ship in the app.
ZEGO_APP_ID=123456789
ZEGO_SERVER_SECRET=0123456789abcdef0123456789abcdef
SEAT_GRACE_MS=30000
SIGNUP_BONUS_COINS=1000

# OAuth Web client ID from Google Cloud Console (Credentials). Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
